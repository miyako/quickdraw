      {"path": "/missingInput/exitCode", "absent": true},
      {"path": "/badOption/error/code", "equals": "invalid_argument"},
      {"path": "/badOption/exitCode", "absent": true},
      {"path": "/options/value/width", "equals": 16},
      {"path": "/options/value/height", "equals": 24},
      {"path": "/options/value/dpi", "equals": 144.5},
      {"path": "/capabilities/value/fidelity/classic_oracle_validated", "equals": false},
