      {"path": "/protocol/ok", "equals": false},
      {"path": "/protocol/stdout", "equals": "not json"},
      {"path": "/protocol/error/code", "equals": "invalid_protocol"},
      {"path": "/protocolTypes", "length": 2, "each": [
        {"path": "/ok", "equals": false},
        {"path": "/stderr", "equals": ""},
        {"path": "/exitCode", "equals": 0},
        {"path": "/error/code", "equals": "invalid_protocol"},
        {"path": "/value", "absent": true}
      ]},
      {"path": "/protocolTypes/0/stdout", "equals": "{\"protocol\":true,\"version\":\"invalid\"}\n"},
      {"path": "/protocolTypes/1/stdout", "equals": "{\"protocol\":false,\"version\":\"invalid\"}\n"},
      {"path": "/protocolNull/ok", "equals": false},
      {"path": "/protocolNull/error/code", "equals": "invalid_protocol"},
      {"path": "/protocolNull/value", "absent": true},
      {"path": "/protocolScalars", "length": 5, "each": [
        {"path": "/ok", "equals": false},
        {"path": "/error/code", "equals": "invalid_protocol"},
        {"path": "/value", "absent": true}
      ]},
      {"path": "/protocolFailure/error/code", "equals": "invalid_protocol"},
      {"path": "/preservedError/failureKind", "equals": "converter"},
      {"path": "/preservedError/error", "equals": {"code": "unsupported", "message": "matte", "offset": 40, "opcode": 33280, "future": "retained"}},
      {"path": "/terminated/failureKind", "equals": "process"},
      {"path": "/terminated/error/code", "equals": "process_terminated"},
      {"path": "/rejectedOptions", "length": 4, "each": [{"path": "/error/code", "equals": "invalid_argument"}, {"path": "/exitCode", "absent": true}]}
    ]
  },
  "execution": {
